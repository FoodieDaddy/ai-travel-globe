{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TravelPlan",
  "type": "object",
  "required": ["title", "summary", "destination", "days", "places", "itinerary"],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "country", "days", "description", "tags"],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "days": {
            "type": "integer",
            "minimum": 1
          },
          "lat": {
            "type": ["number", "null"],
            "minimum": -90,
            "maximum": 90
          },
          "lng": {
            "type": ["number", "null"],
            "minimum": -180,
            "maximum": 180
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "arcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "startLat", "startLng", "endLat", "endLng"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "startLat": { "type": "number" },
          "startLng": { "type": "number" },
          "endLat": { "type": "number" },
          "endLng": { "type": "number" }
        }
      }
    },
    "itinerary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["day", "city", "title", "items"],
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 1
          },
          "city": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
